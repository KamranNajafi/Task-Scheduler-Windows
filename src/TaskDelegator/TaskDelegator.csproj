<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows: portable single-file build for Windows 10/11.
         net48: runs on Windows 7 SP1, 8.1, 10, 11 (needs .NET Framework 4.8). -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TaskDelegator</AssemblyName>
    <RootNamespace>TaskDelegator</RootNamespace>
    <!-- Application icon embedded into the exe (shown on the file, window, taskbar and
         shortcuts). The installer uses the same file via SetupIconFile. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- No embedded Win32 manifest. An embedded application manifest caused a
         side-by-side activation error (CreateProcess code 14001,
         ERROR_SXS_CANT_GEN_ACTCTX) on some Windows installs; removing it fixes
         that and the app runs correctly. Elevation (asInvoker default + a `runas`
         relaunch for the admin console) and DPI awareness are handled in code
         (Program.cs), so no manifest is required. -->
    <NoWin32Manifest>true</NoWin32Manifest>
    <!-- Single source of truth for the version = the repo-root VERSION file, so every
         build (CI or local) shows the current version automatically with no extra flags.
         VERSION holds e.g. "v1.7.0"; <Version> needs a numeric form (1.7.0) while
         <InformationalVersion> keeps the display form ("v1.7.0") shown in the UI. -->
    <_VersionFile>$(MSBuildThisFileDirectory)..\..\VERSION</_VersionFile>
    <_VersionRaw Condition="Exists('$(_VersionFile)')">$([System.IO.File]::ReadAllText('$(_VersionFile)'))</_VersionRaw>
    <_Version Condition="'$(_VersionRaw)' != ''">$(_VersionRaw.Trim())</_Version>
    <_Version Condition="'$(_Version)' == ''">v1.0.0</_Version>
    <!-- <Version> must be numeric (1.7.0); strip the leading "v" with String.Replace
         (version numbers contain no other 'v', and Regex is not a guaranteed MSBuild
         property function). CI also passes -p:Version / -p:InformationalVersion. -->
    <Version>$(_Version.Replace('v', '').Replace('V', ''))</Version>
    <InformationalVersion>$(_Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Task Scheduler - Privileged App Delegation</Product>
    <Company>Kamran Najafi</Company>
    <Authors>Kamran Najafi</Authors>
    <!-- Publish/single-file settings are passed on the CI command line
         (see .github/workflows/build.yml) so a plain `dotnet build` still works. -->
  </PropertyGroup>

  <!-- Common -->
  <ItemGroup>
    <PackageReference Include="TaskScheduler" Version="2.11.0" />
  </ItemGroup>

  <!-- Windows 10/11 build (.NET 8): JSON, WMI and DPAPI ship in the runtime/packages. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Windows 7 build (.NET Framework 4.8): WMI, DPAPI and dynamic COM come from the
       framework; System.Text.Json is added as a package; reference assemblies let the
       project build with the dotnet CLI on any runner. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
    <!-- Satisfies the default implicit 'global using System.Net.Http;' on .NET Framework. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
